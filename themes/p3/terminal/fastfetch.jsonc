{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "color": { "1": "cyan", "2": "white" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "cyan", "title": "white", "separator": "white" },
    "constants": ["\u001b[90m"]
  },
  "modules": [
    "break",
    { "type": "title", "format": "{#1;30;47} {user-name} {#1;30;46} @ {#1;30;47} {host-name} {#0}{#1;36} ▶▶" },
    { "type": "custom", "format": "{#36}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" },
    { "type": "os",       "key": "󰣇 SYS ", "keyColor": "91" },
    { "type": "kernel",   "key": "󰌽 KRN ", "keyColor": "97" },
    { "type": "wm",       "key": "󱂬 WM  ", "keyColor": "91" },
    { "type": "shell",    "key": " SH  ", "keyColor": "97" },
    { "type": "terminal", "key": " TTY ", "keyColor": "91" },
    { "type": "custom", "format": "{#37}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" },
    { "type": "cpu",      "key": "󰻠 CPU ", "keyColor": "91" },
    { "type": "gpu",      "key": "󰢮 GPU ", "keyColor": "91" },
    { "type": "memory",   "key": "󰍛 RAM ", "keyColor": "97" },
    { "type": "disk",     "key": "󰋊 DSK ", "keyColor": "91" },
    { "type": "battery",  "key": "󱐋 PWR ", "keyColor": "91" },
    { "type": "uptime",   "key": "󰔟 UP  ", "keyColor": "97" },
    { "type": "custom", "format": "{#36}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" },
    { "type": "colors", "symbol": "block", "paddingLeft": 2 }
  ]
}
